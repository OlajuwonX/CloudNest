# Copy to .env and fill in from the Appwrite console (https://cloud.appwrite.io)
# All values are public client IDs, not secrets — they end up inside the app bundle.

# Settings → API endpoint (includes the region, e.g. https://fra.cloud.appwrite.io/v1)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Settings → Project ID
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
# Must match a platform registered under Overview → Platforms (the app's package / bundle ID)
EXPO_PUBLIC_APPWRITE_PLATFORM=co.phantomdev.cloudnest

# Databases → your database → ID
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
# Databases → your database → files table → ID
EXPO_PUBLIC_APPWRITE_FILES_TABLE_ID=
# Storage → your bucket → ID
EXPO_PUBLIC_APPWRITE_BUCKET_ID=

# SDK 56+ makes expo/fetch the global fetch. Keep React Native fetch, which
# react-native-appwrite (sessions via cookies, {uri,name,type} uploads) is built for.
EXPO_PUBLIC_USE_RN_FETCH=1
